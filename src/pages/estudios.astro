---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Unidad de Estudios y Licitaciones | CEPEC SpA">

  <!-- Hero -->
  <section class="py-12 bg-gradient-to-br from-slate-900 via-blue-950 to-slate-800">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-blue-400 font-semibold text-sm uppercase tracking-wider">Servicio estrella</span>
        <h1 class="text-5xl font-black text-white mt-2 mb-6">Unidad de Estudios y Licitaciones</h1>
        <p class="text-xl text-slate-300 leading-relaxed mb-6">
          Centro especializado en la generación de propuestas técnicas y económicas para proyectos públicos y privados.
        </p>
        <p class="text-lg text-slate-400 leading-relaxed">
          Del estudio técnico a la presentación de licitaciones. Respondemos con precisión, velocidad y respaldo profesional.
        </p>
      </div>
    </div>
  </section>

  <!-- Qué es la unidad -->
  <section class="py-12 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="text-blue-700 font-semibold text-sm uppercase tracking-wider">Nuestra unidad</span>
          <h2 class="text-4xl font-black text-slate-900 mt-2 mb-6">Centro de Estudios y Desarrollo de Proyectos</h2>
          <p class="text-slate-600 leading-relaxed mb-4">
            La Unidad de Estudios de CEPEC es el núcleo técnico de nuestra operación. Contamos con un equipo de profesionales especialistas capaces de desarrollar propuestas completas para licitaciones públicas y privadas en plazos significativamente menores a los del mercado tradicional.
          </p>
          <p class="text-slate-600 leading-relaxed mb-4">
            Incorporamos herramientas avanzadas de inteligencia artificial para la automatización documental y el análisis de información, lo que nos permite reducir tiempos de preparación y aumentar la calidad y precisión de cada propuesta.
          </p>
          <p class="text-slate-600 leading-relaxed mb-8">
            Esta alianza tecnológica con <a href="https://anichlabs.com" target="_blank" class="text-blue-600 hover:underline">AnichLabs OÜ</a> nos posiciona en el borde de la innovación aplicada a la construcción e ingeniería en Chile.
          </p>
          <a href="/contacto" class="inline-flex items-center px-6 py-3 text-sm font-bold text-white bg-gradient-to-r from-blue-700 to-blue-900 rounded-xl hover:from-blue-800 hover:to-slate-800 transition-all shadow-lg">
            Solicitar una propuesta
          </a>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-blue-50 rounded-2xl p-6 border border-blue-100">
            <div class="text-3xl font-black text-blue-700 mb-2">Récord</div>
            <div class="text-slate-600 text-sm">Tiempo de generación de propuestas</div>
          </div>
          <div class="bg-blue-50 rounded-2xl p-6 border border-blue-100">
            <div class="text-3xl font-black text-blue-700 mb-2">IA</div>
            <div class="text-slate-600 text-sm">Automatización documental avanzada</div>
          </div>
          <div class="bg-blue-50 rounded-2xl p-6 border border-blue-100">
            <div class="text-3xl font-black text-blue-700 mb-2">100%</div>
            <div class="text-slate-600 text-sm">Respaldo de especialistas en terreno</div>
          </div>
          <div class="bg-blue-50 rounded-2xl p-6 border border-blue-100">
            <div class="text-3xl font-black text-blue-700 mb-2">Público</div>
            <div class="text-slate-600 text-sm">y privado</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Servicios de la unidad -->
  <section class="py-12 bg-slate-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-blue-700 font-semibold text-sm uppercase tracking-wider">Qué desarrollamos</span>
        <h2 class="text-4xl font-black text-slate-900 mt-2 mb-4">Servicios de la Unidad</h2>
        <p class="text-slate-600 max-w-2xl mx-auto">Cobertura completa del proceso de estudio, desde la factibilidad inicial hasta la presentación final del proyecto.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {[
          { titulo: 'Estudios de factibilidad', icono: '01' },
          { titulo: 'Presupuestos y cubicaciones', icono: '02' },
          { titulo: 'Bases técnicas y especificaciones', icono: '03' },
          { titulo: 'Cartas Gantt y programación', icono: '04' },
          { titulo: 'Evaluación económica', icono: '05' },
          { titulo: 'Análisis de riesgos', icono: '06' },
          { titulo: 'Preparación de licitaciones', icono: '07' },
          { titulo: 'Documentación técnica', icono: '08' },
          { titulo: 'Propuestas para sector público', icono: '09' },
          { titulo: 'Propuestas para sector privado', icono: '10' },
        ].map((servicio) => (
          <div class="bg-white rounded-2xl p-6 border border-slate-100 hover:border-blue-200 hover:shadow-md transition-all">
            <div class="text-blue-700 font-black text-2xl mb-3">{servicio.icono}</div>
            <p class="text-slate-800 font-semibold text-sm leading-relaxed">{servicio.titulo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- IA Aplicada -->
  <section class="py-12 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="bg-gradient-to-br from-blue-900 to-slate-900 rounded-2xl p-12 text-white">
          <div class="text-6xl font-black text-blue-400 mb-4">IA</div>
          <h3 class="text-2xl font-black mb-4">Inteligencia Artificial Aplicada</h3>
          <p class="text-slate-300 leading-relaxed mb-6">
            En alianza con <a href="https://anichlabs.com" target="_blank" class="text-blue-600 hover:underline">AnichLabs OÜ</a>, incorporamos herramientas avanzadas de análisis de información y automatización documental que transforman el proceso de preparación de propuestas.
          </p>
          <ul class="space-y-3">
            {['Reducción de tiempos de preparación', 'Mayor precisión documental', 'Optimización de costos', 'Mejor competitividad en licitaciones', 'Trazabilidad de cada documento'].map((item) => (
              <li class="flex items-center space-x-3">
                <div class="w-2 h-2 rounded-full bg-blue-400 shrink-0"></div>
                <span class="text-slate-300 text-sm">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <span class="text-blue-700 font-semibold text-sm uppercase tracking-wider">Ventajas competitivas</span>
          <h2 class="text-4xl font-black text-slate-900 mt-2 mb-6">Por qué elegirnos para tu licitación</h2>
          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <div>
                <h4 class="font-bold text-slate-900 mb-1">Respuesta rápida</h4>
                <p class="text-slate-600 text-sm leading-relaxed">Generamos documentación completa en plazos significativamente menores al estándar del mercado.</p>
              </div>
            </div>
            <div class="flex items-start space-x-4">
              <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h4 class="font-bold text-slate-900 mb-1">Precisión documental</h4>
                <p class="text-slate-600 text-sm leading-relaxed">Cada documento es revisado por profesionales especialistas antes de su entrega.</p>
              </div>
            </div>
            <div class="flex items-start space-x-4">
              <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h4 class="font-bold text-slate-900 mb-1">Optimización de costos</h4>
                <p class="text-slate-600 text-sm leading-relaxed">Propuestas económicamente competitivas basadas en análisis riguroso de mercado y experiencia acumulada.</p>
              </div>
            </div>
            <div class="flex items-start space-x-4">
              <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <h4 class="font-bold text-slate-900 mb-1">Especialistas en el borde</h4>
                <p class="text-slate-600 text-sm leading-relaxed">Profesionales con experiencia real en terreno validan cada propuesta antes de su presentación.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-12 bg-gradient-to-br from-slate-900 via-blue-950 to-slate-800">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="text-4xl font-black text-white mb-6">¿Tienes una licitación próxima?</h2>
        <p class="text-slate-300 text-xl leading-relaxed mb-10">
          Contáctanos con los antecedentes del proyecto y te entregamos una propuesta en tiempo récord.
        </p>
        <a href="/contacto" class="inline-flex items-center px-8 py-4 text-lg font-bold text-white bg-gradient-to-r from-blue-600 to-blue-800 hover:from-blue-700 hover:to-blue-900 rounded-xl shadow-xl transition-all">
          Solicitar propuesta ahora
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
