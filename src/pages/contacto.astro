---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Contáctanos | CEPEC SpA">

  <section class="py-12 bg-gradient-to-br from-slate-900 via-blue-950 to-slate-800">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-blue-400 font-semibold text-sm uppercase tracking-wider">Hablemos</span>
        <h1 class="text-5xl font-black text-white mt-2 mb-6">Contáctanos</h1>
        <p class="text-xl text-slate-300 leading-relaxed">
          Cuéntanos sobre tu proyecto y te responderemos a la brevedad. Nuestro equipo está listo para ayudarte.
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">

        <div>
          <span class="text-blue-700 font-semibold text-sm uppercase tracking-wider">Formulario de contacto</span>
          <h2 class="text-4xl font-black text-slate-900 mt-2 mb-8">Envíanos un mensaje</h2>
          <form action="mailto:contacto@cepec.cl" method="POST" enctype="text/plain" class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Nombre completo</label>
                <input type="text" name="nombre" placeholder="Juan Pérez" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all" />
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Empresa</label>
                <input type="text" name="empresa" placeholder="Nombre de tu empresa" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Correo electrónico</label>
              <input type="email" name="correo" placeholder="correo@empresa.cl" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Servicio de interés</label>
              <select name="servicio" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-700 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all bg-white">
                <option value="">Selecciona un servicio</option>
                <option>Obras Civiles</option>
                <option>Edificación</option>
                <option>Prevención, Mantención y Emergencia</option>
                <option>Soluciones para Industria y Minería</option>
                <option>Empresa Patrocinante SERVIU</option>
                <option>Unidad de Estudios y Licitaciones</option>
                <option>Alianza estratégica</option>
                <option>Otro</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Mensaje</label>
              <textarea name="mensaje" rows="5" placeholder="Cuéntanos sobre tu proyecto, necesidad o consulta..." class="w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all resize-none"></textarea>
            </div>
            <button type="submit" class="w-full inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-gradient-to-r from-blue-700 to-blue-900 hover:from-blue-800 hover:to-slate-800 rounded-xl shadow-lg transition-all">
              Enviar mensaje
            </button>
          </form>
        </div>

        <div>
          <span class="text-blue-700 font-semibold text-sm uppercase tracking-wider">Información de contacto</span>
          <h2 class="text-4xl font-black text-slate-900 mt-2 mb-8">Estamos en Limache</h2>

          <div class="space-y-6 mb-12">
            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <h4 class="font-bold text-slate-900 mb-1">Dirección</h4>
                <p class="text-slate-600 text-sm leading-relaxed">Valle del Huinganal, Parcela 182<br/>Limache, Región de Valparaíso</p>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <h4 class="font-bold text-slate-900 mb-1">Teléfono</h4>
                <p class="text-slate-600 text-sm">+56 9 9905 8610</p>
              </div>
            </div>
            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <h4 class="font-bold text-slate-900 mb-1">Correo</h4>
                <p class="text-slate-600 text-sm">contacto@cepec.cl</p>
              </div>
            </div>
          </div>

          <div class="rounded-2xl overflow-hidden border border-slate-200 h-72">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3329.5!2d-71.0920!3d-33.0500!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzPCsDAzJzAwLjAiUyA3McKwMDUnMzEuMiJX!5e0!3m2!1ses!2scl!4v1234567890"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Ubicación CEPEC SpA"
            ></iframe>
          </div>
          <a href="https://maps.google.com/?q=Valle+del+Huinganal+Parcela+182+Limache+Valparaiso" target="_blank" class="inline-flex items-center mt-4 text-blue-700 text-sm font-semibold hover:underline">
            Abrir en Google Maps →
          </a>
        </div>

      </div>
    </div>
  </section>

  <section class="py-12 bg-slate-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-blue-700 font-semibold text-sm uppercase tracking-wider">Respuesta rápida</span>
      <h2 class="text-4xl font-black text-slate-900 mt-2 mb-6">¿Necesitas una propuesta para una licitación?</h2>
      <p class="text-slate-600 text-xl max-w-2xl mx-auto mb-10">Nuestra Unidad de Estudios genera documentos técnicos y económicos en tiempo récord.</p>
      <a href="/estudios" class="inline-flex items-center px-8 py-4 text-lg font-bold text-white bg-gradient-to-r from-blue-700 to-blue-900 hover:from-blue-800 hover:to-slate-800 rounded-xl shadow-xl transition-all">
        Ver Unidad de Estudios
      </a>
    </div>
  </section>

</BaseLayout>
