---
import { NAVIGATION } from '@config/site';
import MobileMenu from '@components/react/MobileMenu';

const { currentPathname } = Astro.props;

const isActiveLink = (href: string): boolean => {
  return href === currentPathname;
};
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200 bg-white/95 backdrop-blur-md shadow-sm">
  <nav class="container mx-auto flex h-20 items-center justify-between px-4 sm:px-6 lg:px-8">

    <div class="flex items-center">
      <a href="/" class="flex items-center group">
        <img src="/logo-cepec.png" alt="CEPEC" class="h-16 w-auto group-hover:scale-105 transition-transform" />
      </a>
    </div>

    <div class="hidden lg:flex lg:items-center lg:space-x-1">
      {NAVIGATION.map((item) => (
        <a href={item.href} class={`px-4 py-2 text-sm font-medium rounded-lg transition-all ${isActiveLink(item.href) ? 'text-blue-700 bg-blue-50' : 'text-slate-700 hover:text-blue-700 hover:bg-blue-50'}`}>
          {item.name}
        </a>
      ))}
    </div>

    <div class="hidden lg:flex lg:items-center lg:space-x-4">
      <a href="/contacto" class="inline-flex items-center px-6 py-2.5 text-sm font-semibold text-white bg-gradient-to-r from-blue-700 to-blue-900 hover:from-blue-800 hover:to-slate-800 rounded-lg shadow-md hover:shadow-lg transition-all">
        Contáctanos
      </a>
    </div>

    <MobileMenu client:load />

  </nav>
</header>
