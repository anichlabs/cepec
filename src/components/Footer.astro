---
import { NAVIGATION, CONTACT, COMPANY } from '@config/site';
---

<footer class="bg-slate-900 text-slate-300">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">

      <div class="lg:col-span-1">
        <div class="flex items-center space-x-3 mb-4">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-gradient-to-br from-blue-700 to-slate-700">
            <span class="text-white font-black text-sm">CE</span>
          </div>
          <div class="flex flex-col leading-tight">
            <span class="text-white font-black tracking-tight">CEPEC</span>
            <span class="text-slate-500 text-xs">Centro de Estudios, Proyectos y Construcción</span>
          </div>
        </div>
        <p class="text-slate-400 text-sm leading-relaxed mb-6">
          Empresa chilena especializada en el estudio, desarrollo y ejecución de proyectos de construcción e ingeniería. Región de Valparaíso.
        </p>
        <div class="mt-2">
          <p class="text-slate-400 text-sm">+56 9 9905 8610</p>
          <p class="text-slate-400 text-sm">contacto@cepec.cl</p>
        </div>
      </div>

      <div>
        <h3 class="text-white font-bold text-sm uppercase tracking-wider mb-6">Navegación</h3>
        <ul class="space-y-3">
          {NAVIGATION.map((item) => (
            <li>
              <a href={item.href} class="text-slate-400 hover:text-blue-400 transition-colors text-sm">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-white font-bold text-sm uppercase tracking-wider mb-6">Servicios</h3>
        <ul class="space-y-3">
          <li><a href="/servicios" class="text-slate-400 hover:text-blue-400 transition-colors text-sm">Obras Civiles</a></li>
          <li><a href="/servicios" class="text-slate-400 hover:text-blue-400 transition-colors text-sm">Edificación</a></li>
          <li><a href="/servicios" class="text-slate-400 hover:text-blue-400 transition-colors text-sm">Prevención y Emergencia</a></li>
          <li><a href="/servicios" class="text-slate-400 hover:text-blue-400 transition-colors text-sm">Industria y Minería</a></li>
          <li><a href="/estudios" class="text-slate-400 hover:text-blue-400 transition-colors text-sm">Unidad de Estudios</a></li>
          <li><a href="/servicios" class="text-slate-400 hover:text-blue-400 transition-colors text-sm">Empresa Patrocinante SERVIU</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-white font-bold text-sm uppercase tracking-wider mb-6">Contacto</h3>
        <ul class="space-y-4 text-sm">
          <li class="flex items-start space-x-3">
            <svg class="w-4 h-4 text-blue-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span class="text-slate-400">Valle del Huinganal, Parcela 182, Limache, Región de Valparaíso</span>
          </li>
          <li class="flex items-center space-x-3">
            <svg class="w-4 h-4 text-blue-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span class="text-slate-400">+56 9 9905 8610</span>
          </li>
          <li class="flex items-center space-x-3">
            <svg class="w-4 h-4 text-blue-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span class="text-slate-400">contacto@cepec.cl</span>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <div class="border-t border-slate-800">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-slate-500 text-sm">© 2026 CEPEC SpA. Todos los derechos reservados.</p>
      <div class="flex space-x-6 text-sm">
        <a href="#" class="text-slate-500 hover:text-blue-400 transition-colors">Política de Privacidad</a>
        <a href="#" class="text-slate-500 hover:text-blue-400 transition-colors">Términos de Uso</a>
      </div>
    </div>
  </div>
</footer>
